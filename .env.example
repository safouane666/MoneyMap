APP_ENV=development
DATABASE_URL=postgresql://clearmoney:clearmoney@localhost:5433/clearmoney
BETTER_AUTH_SECRET=dev-secret-change-me-to-32-chars-min
# Web origin (cookie host) when the browser uses the /cm-api proxy — NOT the API port.
# Production: https://your-domain.example
BETTER_AUTH_URL=http://localhost:8259
WEB_URL=http://localhost:8259
API_PORT=3011
API_HOST=0.0.0.0
# Internal URL the Next.js /cm-api proxy uses to reach the API (server-side only)
API_INTERNAL_URL=http://127.0.0.1:3011
# Comma-separated extra browser origins (phones on LAN), e.g. http://192.168.1.10:8259
EXTRA_WEB_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; default is {WEB_URL}/cm-api/auth/callback/google
GOOGLE_REDIRECT_URI=
BILLING_MODE=free
BILLING_ENABLED=true
BETA_FREE_MODE=true
DEFAULT_PLAN=free
PLAN_FREE_ENABLED=true
PLAN_PLUS_ENABLED=true
PLAN_PLUS_MONTHLY_PRICE=4.99
PLAN_PLUS_ANNUAL_PRICE=39.99
PLAN_PLUS_MONTHLY_PROVIDER_PRICE_ID=
PLAN_PLUS_ANNUAL_PROVIDER_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clearmoney
S3_REGION=us-east-1
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Optional crash reporting (P7.1) — leave unset to no-op; install SDK when enabling
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
