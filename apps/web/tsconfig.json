{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "e2e"]
}
