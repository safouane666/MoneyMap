{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://penny.phronexus-ai.com/cm-api",
        "EXPO_PUBLIC_WEB_URL": "https://penny.phronexus-ai.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://penny.phronexus-ai.com/cm-api",
        "EXPO_PUBLIC_WEB_URL": "https://penny.phronexus-ai.com"
      }
    },
    "ios": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://penny.phronexus-ai.com/cm-api",
        "EXPO_PUBLIC_WEB_URL": "https://penny.phronexus-ai.com"
      }
    },
    "ios-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://penny.phronexus-ai.com/cm-api",
        "EXPO_PUBLIC_WEB_URL": "https://penny.phronexus-ai.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
