# Optional TLS server. Enable on the VPS after certs exist:
#   1. Place fullchain.pem + privkey.pem in deploy/certs/
#   2. cp deploy/nginx/conf.d/ssl.conf.example deploy/nginx/conf.d/ssl.conf
#   3. docker compose ... exec nginx nginx -s reload
#
# Prefer certbot (see docs/DEPLOY_VPS.md) over long-lived manual certs.

