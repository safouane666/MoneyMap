{
  "name": "clear-money",
  "private": true,
  "version": "0.1.0",
  "description": "Penny — AI Money Tracker",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start:public": "powershell -ExecutionPolicy Bypass -File ./scripts/start-public.ps1",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @clear-money/db generate",
    "db:migrate": "pnpm --filter @clear-money/db migrate",
    "db:seed": "pnpm --filter @clear-money/db seed",
    "format": "prettier --write ."
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5",
      "query-string": "7.1.3"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
