APP_ENV=production

# Public browser origin (no path). Must match the URL users open.
WEB_URL=https://your.domain.example
# Better Auth baseURL origin only (same as WEB_URL behind Nginx /cm-api/auth).
BETTER_AUTH_URL=https://your.domain.example

# Generate a long random string (≥32 chars). Never commit the real value.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Internal Compose network — hostname `postgres`, port 5432 (not host 5433).
DATABASE_URL=postgresql://clearmoney:REPLACE_DB_PASSWORD@postgres:5432/clearmoney

# API listen (inside container; Nginx proxies to it)
API_HOST=0.0.0.0
API_PORT=3011
PORT=3011

# Web container → API on Docker network (Next /cm-api server proxy + SSR)
API_INTERNAL_URL=http://api:3011

# Comma-separated extra trusted browser origins if needed
EXTRA_WEB_ORIGINS=

# Google OAuth (optional). Redirect URI: https://your.domain.example/cm-api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Object storage (MinIO on Compose network, or real S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=REPLACE_MINIO_PASSWORD
S3_BUCKET=clearmoney
S3_REGION=us-east-1

# Billing — keep free/beta for v1 unless Stripe live is fully ready
BILLING_MODE=free
BILLING_ENABLED=true
BETA_FREE_MODE=true
DEFAULT_PLAN=free
PLAN_FREE_ENABLED=true
PLAN_PLUS_ENABLED=false
PLAN_PLUS_MONTHLY_PRICE=4.99
PLAN_PLUS_ANNUAL_PRICE=39.99
PLAN_PLUS_MONTHLY_PROVIDER_PRICE_ID=
PLAN_PLUS_ANNUAL_PROVIDER_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Optional AI (app must work without these)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Worker
WORKER_POLL_MS=2000
